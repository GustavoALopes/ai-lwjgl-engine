<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.aether</groupId>
        <artifactId>aether-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>aether-editor</artifactId>
    <dependencies>
        <dependency><groupId>dev.aether</groupId><artifactId>aether-project</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>dev.aether</groupId><artifactId>aether-engine</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>dev.aether</groupId><artifactId>aether-desktop</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>dev.aether</groupId><artifactId>aether-tetris</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>org.joml</groupId><artifactId>joml</artifactId></dependency>
        <dependency><groupId>io.github.spair</groupId><artifactId>imgui-java-binding</artifactId></dependency>
        <dependency><groupId>io.github.spair</groupId><artifactId>imgui-java-lwjgl3</artifactId></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration><mainClass>dev.aether.Main</mainClass></configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>windows-imgui-natives</id>
            <activation><os><family>Windows</family></os></activation>
            <dependencies>
        <dependency><groupId>io.github.spair</groupId><artifactId>imgui-java-natives-windows</artifactId><scope>runtime</scope></dependency>
            </dependencies>
        </profile>
        <profile>
            <id>linux-imgui-natives</id>
            <activation><os><name>Linux</name></os></activation>
            <dependencies>
        <dependency><groupId>io.github.spair</groupId><artifactId>imgui-java-natives-linux</artifactId><scope>runtime</scope></dependency>
            </dependencies>
        </profile>
        <profile>
            <id>macos-imgui-natives</id>
            <activation><os><family>mac</family></os></activation>
            <dependencies>
        <dependency><groupId>io.github.spair</groupId><artifactId>imgui-java-natives-macos</artifactId><scope>runtime</scope></dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
